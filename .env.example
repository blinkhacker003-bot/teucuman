# Teucuman standalone demo server
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true

# Public URL used to rewrite the bundled game page's old Railway URLs.
# Use the exact HTTPS origin that serves this app.
PUBLIC_BASE_URL=https://game.example.com
CORS_ORIGINS=https://game.example.com

# PostgreSQL (recommended for a local PostgreSQL instance)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=teucuman
DB_USER=teucuman_app
DB_PASS=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DB_SSL=false
DB_POOL_MAX=10

# Test/demo wallet only. Not a real-money balance.
DEFAULT_BALANCE=50000
